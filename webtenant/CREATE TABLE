CREATE TABLE sysModule (
    id int (5) NOT NULL AUTO_INCREMENT,
    complain_no varchar (10) NOT NULL,
    id_tenant int (5) NOT NULL,
    reported_by varchar (10) NULL,
    reported_date date NULL,
    serv_req_by varchar (60) NULL,
    location varchar (255) NULL,
    floor varchar (20) NULL,
    billing_type char (1) NULL,
    complain_type char (1) NULL,
    complain_source varchar (20) NULL,
    category_cd varchar (4) NULL,
    lot_no varchar (8) NULL,
    status char (1) NULL,
    work_requested varchar (255) NULL,
    id_tenancy int (5) NOT NULL,
    report_no varchar (20) NULL,
    tenant_no varchar (20) NULL,
    entity_cd varchar (4) NULL,
    project_no varchar (20) NULL,
    picture varchar (255) NULL,
    pic_attached blob NULL,
    PRIMARY KEY (id)
)